# Copy to .env for local development. Values match infra/docker-compose.yml.
# Local-only credentials: never reuse them outside your machine.

# Postgres
POSTGRES_USER=kavach
POSTGRES_PASSWORD=kavach
POSTGRES_DB=kavach
# Host port for the Docker Postgres. Change it (and DATABASE_URL) if 5432 is already in use.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kavach:kavach@localhost:5432/kavach?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kavach-documents
S3_ACCESS_KEY_ID=kavach
S3_SECRET_ACCESS_KEY=kavach-secret
S3_FORCE_PATH_STYLE=true

# API
API_PORT=3001

# Web / mobile
NEXT_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Document storage for uploaded invoices and challans (api + worker).
#   local = a folder on disk (default outside production; no MinIO needed)
#   s3    = the S3-compatible bucket configured above (default when NODE_ENV=production)
STORAGE_DRIVER=local
# Relative to the repository root. The api and the worker must see the same folder.
STORAGE_LOCAL_DIR=.local/documents

# Document queue (api + worker).
#   db     = the worker polls the database (default; no Redis needed)
#   bullmq = the api also puts a wake-up job on Redis so pick-up is immediate
DOCUMENT_QUEUE=db
# Worker tuning (optional).
DOCUMENT_POLL_MS=2000
DOCUMENT_CONCURRENCY=4
# Days after which files of discarded and failed uploads are removed (DECISIONS Q25).
DOCUMENT_RETENTION_DAYS=30

# AI: worker only. Never expose to api, web or mobile (ARCHITECTURE §7.5).
# Without a key, uploaded documents fail with a clear message and can be entered by hand.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: another endpoint (regional or proxy), and the per-call timeout.
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=90000
# AI_PROVIDER: openai (default when a key is set) or fixture.
# fixture answers ONLY for the sample files in test-docs/, from their answer keys. Development
# and demos without network access; it refuses to start with NODE_ENV=production.
AI_PROVIDER=

# Auth. JWT_SECRET must be at least 32 random characters; never commit a real one.
JWT_SECRET=
# Origin of the web app (CORS + refresh-cookie origin check). Comma-separate several.
WEB_ORIGIN=http://localhost:3000
# Set to true behind HTTPS so the refresh cookie is marked Secure. Required in production.
COOKIE_SECURE=false
# Path of the refresh cookie as the browser sees it (default /auth). /kapi/auth when the web app
# proxies the API (API_PROXY_TARGET below), as `pnpm share` does.
COOKIE_PATH=
# Web build only: serve the API through the web app at /kapi (set NEXT_PUBLIC_API_URL=/kapi too).
API_PROXY_TARGET=
# Number of reverse proxies in front of the API (usually 1 in production), so req.ip is the client's.
TRUST_PROXY=
# off: no JSON request log lines on stdout.
REQUEST_LOG=
# Optional rate limits (defaults: 10, 40, 50 failed logins per 15 min; 120 uploads, 30 exports per 10 min).
RATE_LOGIN_PER_PAIR=
RATE_LOGIN_PER_IP=
RATE_LOGIN_PER_IDENTIFIER=
RATE_UPLOADS_PER_10_MIN=
RATE_EXPORTS_PER_10_MIN=
# pnpm ops:check thresholds (defaults 30 and 20).
OPS_MAX_QUEUE_MINUTES=
OPS_MAX_FAILED_24H=

# Integration tests create and drop a throwaway database on this server (defaults to DATABASE_URL).
TEST_DATABASE_URL=
